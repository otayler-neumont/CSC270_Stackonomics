# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# ---------------------------------------------------------------------------
# Rails (default ignores generated by `rails new`)
# ---------------------------------------------------------------------------

# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore assets compiled by Propshaft / Sprockets.
/public/assets

# Ignore CI service files.
/.github/dependabot.yml

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/credentials/*.key

# ---------------------------------------------------------------------------
# Tailwind CSS / asset builds
# ---------------------------------------------------------------------------

# Compiled Tailwind output is rebuildable from `app/assets/tailwind/application.css`.
/app/assets/builds/*
!/app/assets/builds/.keep

# ---------------------------------------------------------------------------
# Node / JavaScript (if/when esbuild, jsbundling, etc. get added later)
# ---------------------------------------------------------------------------
node_modules/
yarn-error.log
yarn-debug.log*
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
npm-debug.log*

# ---------------------------------------------------------------------------
# Ruby / Bundler
# ---------------------------------------------------------------------------
*.gem
*.rbc
/.config
/coverage/
/InstalledFiles
/pkg/
/spec/reports/
/spec/examples.txt
/test/tmp/
/test/version_tmp/
/tmp/
/vendor/bundle
/lib/bundler/man/

# rbenv / rvm / chruby
.ruby-gemset
# (we keep .ruby-version so collaborators use the right Ruby)

# Bundler binstubs (we ship our own bin/ scripts and want them tracked)
# /bin

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
!config/credentials/*.key.example

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------

# VS Code / Cursor
.vscode/
.history/
*.code-workspace

# JetBrains (RubyMine, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr
.idea_modules/
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]

# Emacs
*~
\#*\#
.\#*

# ctags
tags
TAGS

# ---------------------------------------------------------------------------
# Operating systems
# ---------------------------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ---------------------------------------------------------------------------
# Office / presentation lock files
# ---------------------------------------------------------------------------
# PowerPoint, Word, Excel temp lock files (e.g. ~$Stackanomics.pptx).
~$*

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
*.log
*.bak
*.tmp
*.orig
*.rej
.cache/
