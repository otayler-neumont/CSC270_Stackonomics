# Copy to terraform.tfvars and fill in your real values.
# terraform.tfvars is gitignored; terraform.tfvars.example is tracked.

# --- OCI auth (from your Oracle Cloud API key) -------------------------------
tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaa..."
user_ocid        = "ocid1.user.oc1..aaaaaaaa..."
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "us-ashburn-1"

# Use the tenancy OCID to deploy to the root compartment, or paste a child
# compartment OCID.
compartment_ocid = "ocid1.tenancy.oc1..aaaaaaaa..."

# --- Access ------------------------------------------------------------------
# Paste the contents of your ~/.ssh/id_ed25519.pub (or id_rsa.pub) on one line.
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

# Lock SSH down to your own IP once you've confirmed the deploy works.
# Find your IP at https://ifconfig.me
# allowed_ssh_cidr = "203.0.113.42/32"

# --- Shape / sizing ----------------------------------------------------------
# Defaults (2 OCPU / 12 GB) fit inside the Always-Free ARM allowance with
# headroom for a second tiny instance later. Bump to 4 OCPU / 24 GB to use
# the full free allowance on one VM.
# ocpus         = 2
# memory_in_gbs = 12

# --- App ---------------------------------------------------------------------
# git_repo_url = "https://github.com/otayler-neumont/CSC270_Stackonomics.git"
# git_branch   = "phase4-docker"
