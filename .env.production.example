# Copy to .env.production and fill in real values before:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# In the OCI deployment these are generated automatically by cloud-init
# (see infra/terraform/cloud-init.yaml) so you don't have to write them
# by hand on the server.

# 64+ hex characters. Generate with:
#   openssl rand -hex 64
SECRET_KEY_BASE=replace-me-with-openssl-rand-hex-64

# Used by both the web container (DATABASE_URL) and the postgres container.
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=replace-me-with-a-random-string
