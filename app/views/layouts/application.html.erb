<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Bedrock - Gems, Metals & Mines" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bedrock">
    <meta name="description" content="Bedrock is a static field guide to the world's gems, the metals that built civilization, and the great mines they came out of.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="min-h-screen bg-stone-100 text-slate-900 antialiased flex flex-col">
    <header class="bg-slate-900 text-stone-100 shadow-lg border-b-2 border-amber-500/40">
      <div class="max-w-6xl mx-auto px-6 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <%= link_to root_path, class: "flex items-center gap-3 group" do %>
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-md bg-gradient-to-br from-amber-400 to-amber-700 ring-1 ring-amber-300/50 shadow-inner group-hover:scale-105 transition">
            <svg viewBox="0 0 24 24" class="w-6 h-6" aria-hidden="true">
              <rect x="3"  y="5"  width="18" height="3" rx="0.5" fill="#fde68a"/>
              <rect x="3"  y="9"  width="18" height="4" rx="0.5" fill="#475569"/>
              <rect x="3"  y="14" width="18" height="5" rx="0.5" fill="#0f172a"/>
              <rect x="6"  y="10" width="2"  height="2" fill="#fbbf24"/>
              <rect x="13" y="15" width="2"  height="3" fill="#fbbf24"/>
            </svg>
          </span>
          <span>
            <span class="block text-xl font-extrabold tracking-tight leading-none">Bedrock</span>
            <span class="block text-[10px] uppercase tracking-[0.2em] text-amber-300/80">Gems · Metals · Mines</span>
          </span>
        <% end %>

        <nav class="flex items-center gap-1 sm:gap-2 text-sm font-medium">
          <% nav_link_class = "px-3 py-2 rounded-md transition hover:bg-white/10" %>
          <% active_class   = "bg-amber-500/15 text-amber-300 ring-1 ring-amber-400/30" %>

          <%= link_to "Home",   root_path,   class: "#{nav_link_class} #{active_class if current_page?(root_path)}" %>
          <%= link_to "Gems",   gems_path,   class: "#{nav_link_class} #{active_class if current_page?(gems_path)}" %>
          <%= link_to "Metals", metals_path, class: "#{nav_link_class} #{active_class if current_page?(metals_path)}" %>
          <%= link_to "Mines",  mines_path,  class: "#{nav_link_class} #{active_class if current_page?(mines_path)}" %>
        </nav>
      </div>
    </header>

    <% if notice.present? %>
      <div class="max-w-6xl mx-auto w-full px-6 mt-4">
        <div class="rounded-md border border-emerald-300 bg-emerald-50 px-4 py-3 text-emerald-900 shadow-sm">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <main class="flex-1 w-full">
      <%= yield %>
    </main>

    <footer class="mt-16 bg-slate-900 text-stone-300 border-t-2 border-amber-500/40">
      <div class="max-w-6xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-7 h-7 rounded bg-gradient-to-br from-amber-400 to-amber-700 ring-1 ring-amber-300/40">
            <span class="block w-3 h-3 rounded-sm bg-slate-900"></span>
          </span>
          <p class="text-sm">&copy; <%= Date.current.year %> Bedrock - a CSC270 project.</p>
        </div>
        <p class="text-xs text-stone-400">Built with Rails <%= Rails.version %> and Tailwind CSS · Stack codename <em>Stackonomics</em>.</p>
      </div>
    </footer>
  </body>
</html>
