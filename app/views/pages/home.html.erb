<% content_for :title, "Bedrock - Gems, Metals & Mines" %>

<%# Hero %>
<section class="bg-gradient-to-b from-stone-100 via-stone-50 to-stone-100 border-b border-stone-200">
  <div class="max-w-6xl mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
    <div>
      <span class="inline-block text-[11px] font-semibold uppercase tracking-[0.18em] text-amber-800 bg-amber-100 ring-1 ring-amber-300/60 px-3 py-1 rounded-full">
        CSC270 · Phase 2
      </span>
      <h1 class="mt-5 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
        A field guide to what's <span class="text-amber-700">under our feet</span>.
      </h1>
      <p class="mt-5 text-lg text-slate-700 leading-relaxed">
        <strong>Bedrock</strong> is a small reference site about
        <em>gems</em>, <em>metals</em>, and the <em>mines</em> they come from.
      </p>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Built on Ruby on Rails as our sample app for CSC270. As of Phase 2,
        the <%= link_to "Gems", gems_path, class: "underline decoration-dotted hover:text-amber-700" %>
        and <%= link_to "Mines", mines_path, class: "underline decoration-dotted hover:text-amber-700" %>
        pages fetch live data from public APIs on page load - MineralFYI for
        mineral encyclopedia entries and the USGS Mineral Resources Data
        System for real US mine records.
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <%= link_to gems_path,
              class: "inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white px-5 py-2.5 rounded-md font-semibold shadow transition" do %>
          Explore gems
          <span aria-hidden="true">→</span>
        <% end %>
        <%= link_to "See the great mines", mines_path,
              class: "inline-flex items-center gap-2 bg-white hover:bg-stone-50 text-slate-800 border border-stone-300 px-5 py-2.5 rounded-md font-semibold transition" %>
      </div>
    </div>

    <div class="flex justify-center">
      <%# Stylized geological cross-section: rock layers with a gold vein and a tiny mineshaft. %>
      <svg viewBox="0 0 480 360" class="w-full max-w-md drop-shadow-xl" role="img" aria-label="Stylized cross-section of rock layers with a gold vein and mineshaft">
        <defs>
          <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"  stop-color="#fef3c7"/>
            <stop offset="100%" stop-color="#fde68a"/>
          </linearGradient>
          <linearGradient id="grass" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"  stop-color="#65a30d"/>
            <stop offset="100%" stop-color="#4d7c0f"/>
          </linearGradient>
        </defs>

        <rect x="0" y="0" width="480" height="120" fill="url(#sky)"/>

        <path d="M0 120 Q 80 90 160 110 T 320 105 T 480 120 L 480 140 L 0 140 Z" fill="url(#grass)"/>

        <rect x="0" y="140" width="480" height="50"  fill="#d6c8a8"/>
        <rect x="0" y="190" width="480" height="55"  fill="#a8a29e"/>
        <rect x="0" y="245" width="480" height="60"  fill="#57534e"/>
        <rect x="0" y="305" width="480" height="60"  fill="#1c1917"/>

        <path d="M40 150 Q 120 180 180 220 T 360 290 L 380 305 L 360 305 Q 240 240 160 220 T 30 165 Z"
              fill="#fbbf24" opacity="0.85"/>
        <path d="M60 160 Q 140 195 200 235 T 350 295"
              fill="none" stroke="#fde68a" stroke-width="1.5" opacity="0.8"/>

        <circle cx="120" cy="175" r="3" fill="#fde68a"/>
        <circle cx="250" cy="255" r="3" fill="#fde68a"/>
        <circle cx="320" cy="285" r="3" fill="#fde68a"/>

        <rect x="395" y="90" width="40" height="30" fill="#78716c"/>
        <polygon points="395,90 415,70 435,90" fill="#57534e"/>
        <rect x="408" y="100" width="14" height="20" fill="#1c1917"/>

        <rect x="412" y="120" width="6" height="180" fill="#1c1917"/>
        <line x1="412" y1="160" x2="418" y2="160" stroke="#57534e" stroke-width="1"/>
        <line x1="412" y1="200" x2="418" y2="200" stroke="#57534e" stroke-width="1"/>
        <line x1="412" y1="240" x2="418" y2="240" stroke="#57534e" stroke-width="1"/>
        <line x1="412" y1="280" x2="418" y2="280" stroke="#57534e" stroke-width="1"/>

        <g fill="#fbbf24">
          <circle cx="80"  cy="270" r="3"/>
          <circle cx="170" cy="320" r="3"/>
          <circle cx="270" cy="335" r="3"/>
        </g>
      </svg>
    </div>
  </div>
</section>

<%# Three topic cards %>
<section class="max-w-6xl mx-auto px-6 py-14">
  <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">What's on the site.</h2>
  <p class="mt-3 text-slate-700 max-w-3xl leading-relaxed">
    Three sections, one page each.
  </p>

  <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
    <%= link_to gems_path, class: "group bg-white rounded-xl border border-stone-200 p-6 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition" do %>
      <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-emerald-400 to-emerald-700 ring-1 ring-emerald-300/50 flex items-center justify-center">
        <svg viewBox="0 0 24 24" class="w-7 h-7" fill="#ecfeff" aria-hidden="true">
          <polygon points="4,9 12,2 20,9 12,22"/>
          <polyline points="4,9 12,12 20,9" fill="none" stroke="#0f766e" stroke-width="0.7"/>
          <line x1="12" y1="12" x2="12" y2="22" stroke="#0f766e" stroke-width="0.7"/>
        </svg>
      </div>
      <h3 class="mt-5 text-xl font-bold text-slate-900 group-hover:text-emerald-700 transition">Gems</h3>
      <p class="mt-2 text-sm text-slate-600 leading-relaxed">
        Twelve gems with Mohs hardness, what gives each its color, and where
        it's typically mined.
      </p>
      <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-emerald-700 group-hover:gap-2 transition-all">Open gems <span aria-hidden="true">→</span></span>
    <% end %>

    <%= link_to metals_path, class: "group bg-white rounded-xl border border-stone-200 p-6 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition" do %>
      <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-amber-400 to-amber-700 ring-1 ring-amber-300/50 flex items-center justify-center">
        <svg viewBox="0 0 24 24" class="w-7 h-7" fill="#fffbeb" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="1"/>
          <rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/>
          <rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
      </div>
      <h3 class="mt-5 text-xl font-bold text-slate-900 group-hover:text-amber-700 transition">Metals</h3>
      <p class="mt-2 text-sm text-slate-600 leading-relaxed">
        Fifteen metals laid out as periodic-table tiles, grouped into precious,
        base, and strategic.
      </p>
      <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-amber-700 group-hover:gap-2 transition-all">Open metals <span aria-hidden="true">→</span></span>
    <% end %>

    <%= link_to mines_path, class: "group bg-white rounded-xl border border-stone-200 p-6 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition" do %>
      <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-slate-600 to-slate-900 ring-1 ring-slate-500/50 flex items-center justify-center">
        <svg viewBox="0 0 24 24" class="w-7 h-7" fill="#f1f5f9" aria-hidden="true">
          <path d="M2 20 L22 20 L18 9 L12 5 L6 9 Z"/>
          <rect x="10" y="14" width="4" height="6" fill="#1e293b"/>
        </svg>
      </div>
      <h3 class="mt-5 text-xl font-bold text-slate-900 group-hover:text-slate-700 transition">Mines</h3>
      <p class="mt-2 text-sm text-slate-600 leading-relaxed">
        Ten landmark mines from five continents, grouped by region. Some go
        4 km underground; one is wide enough to see from orbit.
      </p>
      <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-slate-700 group-hover:gap-2 transition-all">Open mines <span aria-hidden="true">→</span></span>
    <% end %>
  </div>
</section>

<%# Featured trio %>
<section class="bg-gradient-to-b from-slate-900 to-slate-800 text-stone-100">
  <div class="max-w-6xl mx-auto px-6 py-14">
    <div class="flex items-center justify-between flex-wrap gap-3">
      <h2 class="text-2xl sm:text-3xl font-bold">Featured today.</h2>
      <p class="text-sm text-stone-400">Reload the page for a different gem, metal, and mine.</p>
    </div>

    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-5">
      <div class="rounded-xl bg-slate-800/70 ring-1 ring-white/10 p-5">
        <div class="flex items-center gap-3">
          <span class="text-[10px] uppercase tracking-[0.18em] text-emerald-300 font-semibold">Featured gem</span>
          <span class="h-px flex-1 bg-white/10"></span>
        </div>
        <h3 class="mt-2 text-2xl font-bold"><%= @featured_gem[:name] %></h3>
        <dl class="mt-3 text-sm text-stone-300 space-y-1">
          <div><dt class="inline font-semibold text-stone-200">Mohs:</dt> <dd class="inline"><%= @featured_gem[:mohs] %></dd></div>
          <div><dt class="inline font-semibold text-stone-200">Color:</dt> <dd class="inline"><%= @featured_gem[:color] %></dd></div>
          <div><dt class="inline font-semibold text-stone-200">From:</dt> <dd class="inline"><%= @featured_gem[:origins].join(", ") %></dd></div>
        </dl>
        <p class="mt-3 text-sm text-stone-300 italic">"<%= @featured_gem[:fact] %>"</p>
      </div>

      <div class="rounded-xl bg-slate-800/70 ring-1 ring-white/10 p-5">
        <div class="flex items-center gap-3">
          <span class="text-[10px] uppercase tracking-[0.18em] text-amber-300 font-semibold">Featured metal</span>
          <span class="h-px flex-1 bg-white/10"></span>
        </div>
        <h3 class="mt-2 text-2xl font-bold"><%= @featured_metal[:name] %>
          <span class="ml-2 text-xs font-mono text-amber-200 align-middle bg-amber-500/10 ring-1 ring-amber-400/30 rounded px-1.5 py-0.5"><%= @featured_metal[:symbol] %></span>
        </h3>
        <dl class="mt-3 text-sm text-stone-300 space-y-1">
          <div><dt class="inline font-semibold text-stone-200">Group:</dt> <dd class="inline"><%= @featured_metal[:group] %></dd></div>
          <div><dt class="inline font-semibold text-stone-200">Uses:</dt> <dd class="inline"><%= @featured_metal[:uses] %></dd></div>
          <div><dt class="inline font-semibold text-stone-200">Top producers:</dt> <dd class="inline"><%= @featured_metal[:top].join(", ") %></dd></div>
        </dl>
        <p class="mt-3 text-sm text-stone-300 italic">"<%= @featured_metal[:fact] %>"</p>
      </div>

      <div class="rounded-xl bg-slate-800/70 ring-1 ring-white/10 p-5">
        <div class="flex items-center gap-3">
          <span class="text-[10px] uppercase tracking-[0.18em] text-stone-300 font-semibold">Featured mine</span>
          <span class="h-px flex-1 bg-white/10"></span>
        </div>
        <h3 class="mt-2 text-2xl font-bold"><%= @featured_mine[:name] %></h3>
        <dl class="mt-3 text-sm text-stone-300 space-y-1">
          <div><dt class="inline font-semibold text-stone-200">Location:</dt> <dd class="inline"><%= @featured_mine[:country] %></dd></div>
          <div><dt class="inline font-semibold text-stone-200">Type:</dt> <dd class="inline"><%= @featured_mine[:type] %></dd></div>
          <div><dt class="inline font-semibold text-stone-200">Commodity:</dt> <dd class="inline"><%= @featured_mine[:commodity] %></dd></div>
        </dl>
        <p class="mt-3 text-sm text-stone-300 italic">"<%= @featured_mine[:claim] %>"</p>
      </div>
    </div>
  </div>
</section>

<%# Tip form (Phase 1 form requirement) %>
<section class="max-w-6xl mx-auto px-6 py-14">
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 items-start">
    <div class="lg:col-span-2">
      <span class="inline-block text-[11px] font-semibold uppercase tracking-[0.18em] text-amber-800 bg-amber-100 ring-1 ring-amber-300/60 px-3 py-1 rounded-full">
        Send us a tip
      </span>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900">Spot something we should add?</h2>
      <p class="mt-4 text-slate-700 leading-relaxed">
        Know a gem we should add, or a mine with a good story? Drop a note
        below. The form doesn't actually save anything yet; we'll wire it up
        to a model in a later phase.
      </p>
    </div>

    <div class="lg:col-span-3 bg-white rounded-xl border border-stone-200 shadow-sm p-6 sm:p-8">
      <%= form_with url: submit_tip_path, method: :post, local: true, class: "space-y-5" do |f| %>
        <div>
          <%= f.label :name, "Your name", class: "block text-sm font-semibold text-slate-700" %>
          <%= f.text_field :name, required: true,
                placeholder: "Prospector McGee",
                class: "mt-1 block w-full rounded-md border border-stone-300 px-3 py-2 shadow-sm focus:border-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-200" %>
        </div>

        <div>
          <%= f.label :email, "Email", class: "block text-sm font-semibold text-slate-700" %>
          <%= f.email_field :email, required: true,
                placeholder: "you@example.com",
                class: "mt-1 block w-full rounded-md border border-stone-300 px-3 py-2 shadow-sm focus:border-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-200" %>
        </div>

        <div>
          <%= f.label :topic, "Topic", class: "block text-sm font-semibold text-slate-700" %>
          <%= f.select :topic,
                ["A gem worth featuring", "A metal worth featuring", "A mine we missed", "Site feedback", "Something else"],
                { include_blank: "Pick a topic" },
                class: "mt-1 block w-full rounded-md border border-stone-300 px-3 py-2 shadow-sm bg-white focus:border-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-200" %>
        </div>

        <div>
          <%= f.label :message, "Your tip", class: "block text-sm font-semibold text-slate-700" %>
          <%= f.text_area :message, rows: 5, required: true,
                placeholder: "What did you find?",
                class: "mt-1 block w-full rounded-md border border-stone-300 px-3 py-2 shadow-sm focus:border-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-200" %>
        </div>

        <div class="flex items-center gap-3">
          <%= f.submit "Send tip",
                class: "bg-amber-600 hover:bg-amber-700 text-white px-5 py-2.5 rounded-md font-semibold shadow transition cursor-pointer" %>
          <span class="text-xs text-stone-500">Demo only: nothing is saved yet.</span>
        </div>
      <% end %>
    </div>
  </div>
</section>
