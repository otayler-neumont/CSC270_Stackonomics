<% content_for :title, "Contact Us | Ruby on Rails Sample App" %>

<section class="max-w-6xl mx-auto px-6 py-14">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
    <div>
      <span class="inline-block text-xs font-semibold uppercase tracking-wider text-rose-700 bg-rose-100 px-3 py-1 rounded-full">Contact</span>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900">Get in touch</h1>
      <p class="mt-4 text-lg text-slate-700 leading-relaxed">
        Have a question about our Phase 1 prototype, our chosen stack, or how we
        plan to grow this app in upcoming phases? Drop us a note using the form on
        this page and we'll get back to you as soon as we can.
      </p>
      <p class="mt-3 text-slate-700 leading-relaxed">
        Heads up: this is a <strong>non-functional demo form</strong>. It exists to
        show the layout and styling for Phase 1 &mdash; submitting it just shows a
        confirmation message. We'll wire it up to a real Active Record model and
        mailer in a later phase.
      </p>

      <div class="mt-8">
        <%= image_tag "contact_illustration.svg",
              alt: "Illustration of an envelope and a chat bubble",
              class: "w-full max-w-sm" %>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 sm:p-8">
      <%= form_with url: submit_contact_path, method: :post, local: true, class: "space-y-5" do |f| %>
        <div>
          <%= f.label :name, "Full name", class: "block text-sm font-semibold text-slate-700" %>
          <%= f.text_field :name, required: true,
                placeholder: "Ada Lovelace",
                class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-rose-600 focus:outline-none focus:ring-2 focus:ring-rose-200" %>
        </div>

        <div>
          <%= f.label :email, "Email", class: "block text-sm font-semibold text-slate-700" %>
          <%= f.email_field :email, required: true,
                placeholder: "you@example.com",
                class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-rose-600 focus:outline-none focus:ring-2 focus:ring-rose-200" %>
        </div>

        <div>
          <%= f.label :subject, "Subject", class: "block text-sm font-semibold text-slate-700" %>
          <%= f.select :subject,
                ["General question", "Stack feedback", "Phase 1 demo", "Something else"],
                { include_blank: "Pick a topic" },
                class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm bg-white focus:border-rose-600 focus:outline-none focus:ring-2 focus:ring-rose-200" %>
        </div>

        <div>
          <%= f.label :message, "Message", class: "block text-sm font-semibold text-slate-700" %>
          <%= f.text_area :message, rows: 5, required: true,
                placeholder: "Tell us what's on your mind...",
                class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-rose-600 focus:outline-none focus:ring-2 focus:ring-rose-200" %>
        </div>

        <div class="flex items-center gap-3">
          <%= f.submit "Send message",
                class: "bg-rose-700 hover:bg-rose-800 text-white px-5 py-2.5 rounded-md font-semibold shadow transition cursor-pointer" %>
          <span class="text-xs text-slate-500">No data is actually saved.</span>
        </div>
      <% end %>
    </div>
  </div>
</section>
