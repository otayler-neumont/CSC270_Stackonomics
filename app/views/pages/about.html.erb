<% content_for :title, "About the Team | Ruby on Rails Sample App" %>

<section class="bg-gradient-to-b from-slate-50 to-white">
  <div class="max-w-6xl mx-auto px-6 py-14">
    <div class="max-w-3xl">
      <span class="inline-block text-xs font-semibold uppercase tracking-wider text-rose-700 bg-rose-100 px-3 py-1 rounded-full">About</span>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900">Meet the Team</h1>
      <p class="mt-4 text-lg text-slate-700 leading-relaxed">
        We are a small CSC270 project team exploring full-stack development with
        Ruby on Rails. Each of us takes ownership of a slice of the stack, but we
        pair often, review each other's pull requests, and demo new features to
        the rest of the class at the end of every phase.
      </p>
      <p class="mt-4 text-slate-700 leading-relaxed">
        Our goal for the term is to ship a working web application end-to-end &mdash;
        from a routed controller action to a styled view backed by a real database.
        Phase 1 is the foundation: a clean Rails project, three styled pages, and a
        shared layout we can build on.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @team_members.each do |member| %>
        <article class="bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-lg transition overflow-hidden flex flex-col">
          <div class="bg-gradient-to-br from-rose-100 to-amber-100 flex items-center justify-center p-6">
            <%= image_tag member[:image],
                  alt: "Portrait of #{member[:name]}",
                  class: "w-32 h-32 rounded-full ring-4 ring-white shadow-md object-cover bg-white" %>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <h3 class="text-xl font-bold text-slate-900"><%= member[:name] %></h3>
            <p class="text-sm font-semibold text-rose-700 uppercase tracking-wide"><%= member[:role] %></p>
            <p class="mt-3 text-slate-600 leading-relaxed text-sm flex-1"><%= member[:bio] %></p>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>
