<% content_for :title, "Create account · Bedrock" %>

<%= render "specimens/page_hero",
      badge_text: "Membership",
      badge_classes: "text-emerald-800 bg-emerald-100 ring-1 ring-emerald-300/60",
      title: "Create your account",
      subtitle: "Join Bedrock to start your own specimen collection, browse other collectors, and trade notes on where the good rocks come from." %>

<section class="max-w-md mx-auto px-6 py-12">
  <div class="rounded-xl bg-white shadow-lg ring-1 ring-stone-200 p-6 sm:p-8">
    <% if alert = flash[:alert] %>
      <p class="mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" id="alert"><%= alert %></p>
    <% end %>

    <%= form_with model: @user, url: registration_path, class: "space-y-5" do |form| %>
      <div>
        <label for="user_name" class="block text-sm font-semibold text-slate-800">Display name <span class="text-red-600">*</span></label>
        <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name",
              placeholder: "e.g. Ada Lovelace",
              class: "mt-1.5 w-full rounded-lg border border-stone-300 bg-stone-50/50 px-4 py-2.5 text-slate-900 shadow-sm placeholder:text-stone-400 focus:bg-white focus:ring-2 focus:ring-amber-500/40 focus:border-amber-500 transition" %>
      </div>

      <div>
        <label for="user_email_address" class="block text-sm font-semibold text-slate-800">Email <span class="text-red-600">*</span></label>
        <%= form.email_field :email_address, required: true, autocomplete: "username",
              placeholder: "you@example.com",
              class: "mt-1.5 w-full rounded-lg border border-stone-300 bg-stone-50/50 px-4 py-2.5 text-slate-900 shadow-sm placeholder:text-stone-400 focus:bg-white focus:ring-2 focus:ring-amber-500/40 focus:border-amber-500 transition" %>
      </div>

      <div>
        <label for="user_password" class="block text-sm font-semibold text-slate-800">Password <span class="text-red-600">*</span></label>
        <%= form.password_field :password, required: true, autocomplete: "new-password",
              placeholder: "At least 6 characters", maxlength: 72,
              class: "mt-1.5 w-full rounded-lg border border-stone-300 bg-stone-50/50 px-4 py-2.5 text-slate-900 shadow-sm placeholder:text-stone-400 focus:bg-white focus:ring-2 focus:ring-amber-500/40 focus:border-amber-500 transition" %>
      </div>

      <div>
        <label for="user_password_confirmation" class="block text-sm font-semibold text-slate-800">Confirm password <span class="text-red-600">*</span></label>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
              placeholder: "Repeat your password", maxlength: 72,
              class: "mt-1.5 w-full rounded-lg border border-stone-300 bg-stone-50/50 px-4 py-2.5 text-slate-900 shadow-sm placeholder:text-stone-400 focus:bg-white focus:ring-2 focus:ring-amber-500/40 focus:border-amber-500 transition" %>
      </div>

      <%= form.submit "Create account",
            class: "w-full inline-flex justify-center items-center px-5 py-2.5 rounded-lg bg-amber-600 text-white font-semibold shadow-md hover:bg-amber-700 transition cursor-pointer" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-slate-600">
      Already have an account?
      <%= link_to "Sign in", new_session_path, class: "font-semibold text-amber-700 hover:text-amber-900 underline decoration-dotted" %>
    </p>
  </div>
</section>
