<% content_for :title, "#{@specimen.name} · Bedrock" %>
<% style = specimen_tint_style(@specimen.tint) %>
<% owner = @specimen.owned_by?(current_user) %>

<%= render "breadcrumb", back_label: "All specimens", back_path: specimens_path %>

<div class="bg-gradient-to-br <%= style[:bg] %> relative overflow-hidden border-b border-stone-200">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.25),transparent_60%)]"></div>
  <div class="max-w-6xl mx-auto px-6 py-12 sm:py-16 flex flex-col sm:flex-row items-center gap-8 relative">
    <div class="shrink-0"><%= specimen_gem_svg(@specimen.tint, "w-28 h-28 sm:w-36 sm:h-36") %></div>
    <div class="text-center sm:text-left">
      <span class="inline-block text-[11px] font-semibold uppercase tracking-[0.18em] <%= style[:badge] %> ring-1 px-3 py-1 rounded-full"><%= @specimen.tint || "slate" %> tint</span>
      <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold text-slate-900 drop-shadow-sm"><%= @specimen.name %></h1>
      <p class="mt-2 text-lg text-slate-800/90"><%= @specimen.color.presence || "Color not recorded" %></p>
      <div class="mt-4 flex items-center justify-center sm:justify-start gap-3">
        <%= render "owner_badge", specimen: @specimen %>
      </div>
    </div>
  </div>
</div>

<div class="max-w-6xl mx-auto px-6 py-10">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 space-y-6">
      <article class="rounded-xl bg-white shadow-md ring-1 ring-stone-200 overflow-hidden">
        <div class="px-6 py-4 bg-stone-50 border-b border-stone-100">
          <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-slate-500">Field data</h2>
        </div>
        <dl class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <dt class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Mohs hardness</dt>
            <dd class="mt-1 text-lg font-medium text-slate-900"><%= @specimen.mohs ? "#{@specimen.mohs} / 10" : "—" %></dd>
          </div>
          <div>
            <dt class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Origin</dt>
            <dd class="mt-1 text-lg font-medium text-slate-900"><%= @specimen.origin.presence || "—" %></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Color</dt>
            <dd class="mt-1 text-lg font-medium text-slate-900"><%= @specimen.color.presence || "—" %></dd>
          </div>
          <div class="sm:col-span-2"><%= specimen_mohs_meter(@specimen.mohs) %></div>
        </dl>
      </article>

      <% if @specimen.fact.present? %>
        <article class="rounded-xl bg-gradient-to-br from-slate-900 to-slate-800 text-stone-100 shadow-lg p-6 ring-1 ring-slate-700">
          <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-amber-300/90">Field note</h2>
          <p class="mt-3 text-lg leading-relaxed text-stone-200 italic">&ldquo;<%= @specimen.fact %>&rdquo;</p>
        </article>
      <% end %>

      <%= render "comments", specimen: @specimen %>
    </div>

    <aside class="space-y-4">
      <div class="rounded-xl bg-white shadow-md ring-1 ring-stone-200 p-5 sticky top-6">
        <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-slate-500">Actions</h2>
        <div class="mt-4 flex flex-col gap-2">
          <%= render "like_button", specimen: @specimen, size: :lg %>

          <% if owner %>
            <%= link_to "Edit specimen", edit_specimen_path(@specimen), class: "w-full text-center px-4 py-2.5 rounded-lg bg-amber-600 text-white font-semibold hover:bg-amber-700 transition" %>
            <%= link_to "Delete", delete_confirm_specimen_path(@specimen), class: "w-full text-center px-4 py-2.5 rounded-lg bg-red-50 ring-1 ring-red-200 text-red-800 font-semibold hover:bg-red-100 transition" %>
          <% end %>
          <%= link_to "Back to collection", specimens_path, class: "w-full text-center px-4 py-2.5 rounded-lg ring-1 ring-stone-200 text-slate-700 font-medium hover:bg-stone-50 transition" %>
        </div>
        <a href="/api/specimens/<%= @specimen.id %>" target="_blank" rel="noopener"
           class="mt-4 block text-center text-xs text-slate-500 hover:text-amber-700 underline decoration-dotted">
          Open raw JSON ↗
        </a>
      </div>

      <% unless owner %>
        <div class="rounded-xl bg-amber-50 ring-1 ring-amber-200/80 p-5 text-sm text-amber-950">
          <p class="font-semibold">Not your specimen</p>
          <p class="mt-1">You're viewing another collector's find. You can like it and leave a comment, but only the owner can edit it.</p>
        </div>
      <% end %>
    </aside>
  </div>
</div>
