<section class="bg-gradient-to-b from-stone-100 to-stone-50 border-b border-stone-200">
  <div class="max-w-6xl mx-auto px-6 py-12 sm:py-14">
    <span class="inline-block text-[11px] font-semibold uppercase tracking-[0.18em] <%= badge_classes %> px-3 py-1 rounded-full">
      <%= badge_text %>
    </span>
    <h1 class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900"><%= title %></h1>
    <% if local_assigns[:subtitle] %>
      <p class="mt-4 max-w-3xl text-base sm:text-lg text-slate-700 leading-relaxed"><%= subtitle %></p>
    <% end %>
    <% if local_assigns[:actions] %>
      <div class="mt-6 flex flex-wrap gap-3"><%= actions %></div>
    <% end %>
  </div>
</section>
