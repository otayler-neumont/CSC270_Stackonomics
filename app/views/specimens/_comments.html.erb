<article id="comments" class="rounded-xl bg-white shadow-md ring-1 ring-stone-200 overflow-hidden">
  <div class="px-6 py-4 bg-stone-50 border-b border-stone-100 flex items-center justify-between">
    <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-slate-500">Comments</h2>
    <span class="text-xs font-semibold text-slate-500 bg-white ring-1 ring-stone-200 px-2.5 py-0.5 rounded-full"><%= specimen.comments.size %></span>
  </div>

  <div class="p-6 space-y-6">
    <% if current_user %>
      <%= form_with model: [specimen, Comment.new], class: "flex flex-col gap-3" do |form| %>
        <%= form.text_area :body, rows: 3, required: true,
              placeholder: "Ask where they found it, or share what you know about this specimen…",
              class: "w-full rounded-lg border border-stone-300 bg-stone-50/50 px-4 py-3 text-sm shadow-sm placeholder:text-stone-400 focus:bg-white focus:ring-2 focus:ring-amber-500/40 focus:border-amber-500 transition leading-relaxed" %>
        <div class="flex justify-end">
          <%= form.submit "Post comment",
                class: "inline-flex items-center px-4 py-2 rounded-lg bg-amber-600 text-white text-sm font-semibold shadow-sm hover:bg-amber-700 transition cursor-pointer" %>
        </div>
      <% end %>
    <% else %>
      <div class="rounded-lg border border-stone-200 bg-stone-50 px-4 py-3 text-sm text-slate-600">
        <%= link_to "Sign in", new_session_path, class: "font-semibold text-amber-700 hover:text-amber-900 underline decoration-dotted" %>
        to join the conversation.
      </div>
    <% end %>

    <% if specimen.comments.any? %>
      <ul class="space-y-5">
        <% specimen.comments.each do |comment| %>
          <li id="comment-<%= comment.id %>" class="flex gap-3">
            <span class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full bg-gradient-to-br from-amber-300 to-amber-600 text-slate-900 text-xs font-bold ring-1 ring-amber-300/50"><%= comment.user.initials %></span>
            <div class="flex-1 min-w-0">
              <div class="flex items-baseline justify-between gap-2">
                <p class="text-sm font-semibold text-slate-900 truncate">
                  <%= link_to comment.user.display_name, user_path(comment.user), class: "hover:text-amber-800 transition" %>
                </p>
                <time class="shrink-0 text-xs text-slate-400" datetime="<%= comment.created_at.iso8601 %>"><%= comment.created_at.strftime("%b %-d, %Y") %></time>
              </div>
              <p class="mt-1 text-sm text-slate-700 leading-relaxed whitespace-pre-wrap break-words"><%= comment.body %></p>
              <% if comment.editable_by?(current_user) %>
                <%= button_to "Remove", specimen_comment_path(specimen, comment), method: :delete,
                      class: "mt-1.5 text-xs font-medium text-red-700 hover:text-red-900 hover:underline",
                      form: { data: { turbo_confirm: "Remove this comment?" } } %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-500 italic">No comments yet. Be the first to ask about this specimen.</p>
    <% end %>
  </div>
</article>
