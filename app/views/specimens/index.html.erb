<% content_for :title, "Specimen Collections · Bedrock" %>

<% mine = @scope == "mine" && current_user %>

<%= render "page_hero",
      badge_text: "Phase 5 · Collections",
      badge_classes: "text-violet-800 bg-violet-100 ring-1 ring-violet-300/60",
      title: (mine ? "My collection" : "Community collections"),
      subtitle: (mine ?
        "Specimens you've catalogued. Add a new find, edit your notes, or see who's been liking your rocks.".html_safe :
        "Every collector's specimens in one place. Browse what other members have found, like the standouts, and ask where they dug them up.".html_safe),
      actions: safe_join([
        (current_user ? link_to("Add specimen", new_specimen_path, class: "inline-flex items-center px-4 py-2.5 rounded-lg bg-amber-600 text-white font-semibold shadow-md hover:bg-amber-700 transition") :
          link_to("Sign in to add", new_session_path, class: "inline-flex items-center px-4 py-2.5 rounded-lg bg-amber-600 text-white font-semibold shadow-md hover:bg-amber-700 transition")),
        link_to("Raw JSON", "/api/specimens", target: "_blank", rel: "noopener", class: "inline-flex items-center px-4 py-2.5 rounded-lg bg-white ring-1 ring-stone-300 text-slate-800 font-medium hover:bg-stone-50 transition")
      ]) %>

<section class="max-w-6xl mx-auto px-6 py-12">
  <div class="flex items-end justify-between flex-wrap gap-4 mb-8">
    <div>
      <h2 class="text-2xl font-bold text-slate-900"><%= mine ? "Your specimens" : "All specimens" %></h2>
      <p class="mt-1 text-slate-600 text-sm">
        <%= pluralize(@specimens.size, "specimen") %><%= " in your collection" if mine %>. Click a card for details, comments, and likes.
      </p>
    </div>

    <% if current_user %>
      <div class="inline-flex rounded-lg ring-1 ring-stone-300 bg-white overflow-hidden text-sm font-semibold shadow-sm">
        <%= link_to "Everyone", specimens_path,
              class: "px-4 py-2 transition #{mine ? 'text-slate-600 hover:bg-stone-50' : 'bg-amber-600 text-white'}" %>
        <%= link_to "Mine", specimens_path(scope: "mine"),
              class: "px-4 py-2 transition border-l border-stone-200 #{mine ? 'bg-amber-600 text-white' : 'text-slate-600 hover:bg-stone-50'}" %>
      </div>
    <% end %>
  </div>

  <% if @specimens.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <%= render partial: "specimen_card", collection: @specimens, as: :specimen %>
    </div>
  <% else %>
    <div class="mt-8 rounded-xl border-2 border-dashed border-stone-300 bg-white/60 px-8 py-16 text-center">
      <div class="mx-auto w-16 h-16 rounded-full bg-amber-100 flex items-center justify-center text-2xl" aria-hidden="true">&#9671;</div>
      <h3 class="mt-4 text-lg font-bold text-slate-900"><%= mine ? "Your collection is empty" : "No specimens yet" %></h3>
      <p class="mt-2 text-slate-600 max-w-md mx-auto">
        <%= mine ? "Add your first find to start your collection." : "Be the first to add a specimen to the community." %>
      </p>
      <% if current_user %>
        <%= link_to "Add specimen", new_specimen_path, class: "mt-6 inline-flex items-center px-4 py-2 rounded-lg bg-amber-600 text-white font-semibold hover:bg-amber-700 transition" %>
      <% else %>
        <%= link_to "Sign in to add", new_session_path, class: "mt-6 inline-flex items-center px-4 py-2 rounded-lg bg-amber-600 text-white font-semibold hover:bg-amber-700 transition" %>
      <% end %>
    </div>
  <% end %>
</section>
