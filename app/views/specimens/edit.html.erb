<% content_for :title, "Edit specimen · Bedrock" %>

<%= render "breadcrumb", back_label: "Back to specimen", back_path: specimen_path(@specimen) %>

<%= render "page_hero",
      badge_text: "Edit",
      badge_classes: "text-sky-800 bg-sky-100 ring-1 ring-sky-300/60",
      title: "Edit specimen",
      subtitle: "Updating \u201C#{@specimen.name}\u201D in your collection.".html_safe %>

<section class="max-w-6xl mx-auto px-6 pb-16">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 -mt-4">
    <div class="lg:col-span-2">
      <div class="rounded-xl bg-white shadow-lg ring-1 ring-stone-200 p-6 sm:p-8">
        <%= render "form" %>
      </div>
    </div>

    <aside>
      <div class="rounded-xl bg-white shadow-md ring-1 ring-stone-200 overflow-hidden sticky top-6">
        <div class="h-28 bg-gradient-to-br <%= specimen_tint_style(@specimen.tint)[:bg] %> flex items-center justify-center">
          <%= specimen_gem_svg(@specimen.tint, "w-16 h-16") %>
        </div>
        <div class="p-5">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Current</p>
          <p class="mt-2 text-xl font-bold text-slate-900"><%= @specimen.name %></p>
          <p class="mt-1 text-sm text-slate-600"><%= [@specimen.color.presence, (@specimen.mohs ? "Mohs #{@specimen.mohs}" : nil)].compact.join(" · ").presence || "—" %></p>
        </div>
      </div>
    </aside>
  </div>
</section>
